# Local single-user operator token. Leave unset for a fresh token at startup.
SDE_API_TOKEN=
SDE_DATA_DIR=.data
# Comma-separated exact owner/repository pairs. Defaults to demo-only.
SDE_ALLOWED_REPOS=udbhav-metla/sde-agent-starter-kit
GITHUB_TOKEN=
# Enable only with a fine-grained token scoped to disposable repositories.
SDE_GITHUB_WRITE=false
# AWS uses the standard boto3 credential chain. Never add secrets to source.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
# Pre-pull this image. Use an audited digest for shared environments.
SDE_SANDBOX_IMAGE=python:3.12-slim
